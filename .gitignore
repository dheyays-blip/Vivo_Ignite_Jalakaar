# --- heavy / regenerable data: never commit ---
data/raw/*
data/interim/*.parquet
data/*.db
.cache/
*.sqlite
*.sqlite3

# --- secrets: a leaked Twilio auth token is someone else's phone bill ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.python-version

# --- os / editor ---
.DS_Store
.vscode/
.idea/

# --- committed exceptions: small, text, diffable ---
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/interim/mh_wells.csv
!data/interim/reservoirs.csv

# [B] added 8 Aug
# NOTE the trailing /* rather than /. A bare `reports/` makes git skip the
# directory entirely, so the negations below can never fire — the same trap
# that blocked data/parquet on 8 Aug.
reports/*
# Metrics are small, text, diffable, the landing page quotes them and
# api/verify_model.py reads them. Plots stay out.
# NB: gitignore has no trailing comments — a `#` mid-line is part of the
# pattern, which silently breaks the rule. Comments go on their own line.
!reports/*.json
data/*.db-wal
data/*.db-shm
# app.db rollback journal — user signups, never commit
data/*.db-journal
data/test_*.db
# bind-mount debris, not ours
data/.fuse_hidden*

# --- trained models ---
# The served model is committed: the demo will not produce a model-backed
# score without it, and a clone on another laptop the morning of the demo is
# exactly when you find that out. 3.5 MB, well under GitHub's limit.
# Experiment variants are not — regenerate with ml/02_xgboost.py.
models/*
!models/xgb_causal.json

# derived training artefacts — regenerate with tools/export_parquet.py
data/parquet/*

# BOOTSTRAP — what a fresh clone needs to rebuild jalaakar.db (1.9 GB, ignored).
# Measurements are shipped; interpolations, features and scores are rebuilt by
# tools/bootstrap.py so nobody inherits a stale number they cannot trace.
#
# features.parquet was here (196 MB) and has been removed: it is built from
# gw_daily, so it carries the target leak documented in ml/01_baseline.py, and
# nothing reads it any more. Shipping a table the README warns against is not
# a service, and dropping it makes the clone both smaller and correct.
!data/bootstrap/
!data/bootstrap/*.parquet
