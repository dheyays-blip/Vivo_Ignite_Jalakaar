# Normalise line endings so Mac/Linux/Windows don't fight
* text=auto eol=lf
# Notebooks: diff as text but never auto-merge (JSON merges are unresolvable)
*.ipynb -merge
# Binary / generated — never diff these
*.parquet binary
*.db      binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.xlsx    binary
data/parquet/*.parquet filter=lfs diff=lfs merge=lfs -text
data/bootstrap/*.parquet filter=lfs diff=lfs merge=lfs -text
