# JALAAKAR — copy to `.env` and fill in. `.env` is gitignored; keep it that way.
#
#     cp .env.example .env
#
# Everything here is OPTIONAL. With no .env at all the system still scores,
# still renders all three languages, and still writes to alert_log — it just
# records channel='console', status='rendered' instead of claiming delivery.
#
# ---------------------------------------------------------------------------
# Real WhatsApp delivery (Twilio sandbox — free)
# ---------------------------------------------------------------------------
# 1. console.twilio.com -> Admin -> Account management -> API keys & tokens
#    Copy the ACCOUNT SID (starts with "AC") and the AUTH TOKEN.
# 2. Messaging -> Try it out -> Send a WhatsApp message. Note the join phrase.
# 3. From EVERY phone that should receive alerts, WhatsApp the join phrase
#    ("join <two-words>") to +1 415 523 8886. Twilio replies to confirm.
#    This expires 3 days after joining — rejoin and the number works again.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The shared sandbox number. Only change this once you have your own
# WhatsApp-enabled Twilio number approved.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
